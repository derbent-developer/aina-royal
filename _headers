# Правила кэширования для Cloudflare Pages.
# Внимание: Cloudflare применяет ВСЕ подходящие правила сразу и склеивает
# их значения. Поэтому Cache-Control задан ровно один раз на каждый путь,
# а в общем правиле "/*" его нет — иначе он подмешается ко всем остальным.

# Общее — только заголовки безопасности, без кэша.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Страницу браузер перепроверяет каждый раз, иначе правки повиснут в кэше.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Стили и скрипты помечены версией (?v=6) — их можно держать долго:
# при следующей правке скрипт обновления сменит версию, браузер скачает заново.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Фотографии лежат под своими именами, поэтому неделя, а не «навсегда»:
# заменишь файл тем же именем — обновление дойдёт до посетителей за 7 дней.
/assets/photos/*
  Cache-Control: public, max-age=604800
